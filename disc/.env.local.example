# Шаблон локального окружения запусков: скопировать в .env.local и вписать
# свои значения. .env.local в git не живёт; скрипты подхватывают его при
# старте, переменные из профиля шелла имеют приоритет. Секретов в значениях
# быть не должно — только пути к файлам с ними (файлы вне репо).

# адрес сервера ollama (дефолт http://localhost:11434)
OLLAMA_BASE_URL=http://ollama-host:11434

# --- облачные модели (когда понадобятся) ---
# путь к env-файлу с ключами родных API (GigaChat/Яндекс/DeepSeek)
# MODELS_RU_ENV=~/path/to/cloud-keys.env

# путь к файлу с ключом OpenRouter и адрес прокси (или OPENROUTER_PROXY=host:port)
# OPENROUTER_KEY_FILE=~/.config/llm-keys/openrouter.key
# OPENROUTER_PROXY_FILE=~/.config/llm-keys/openrouter-proxy
