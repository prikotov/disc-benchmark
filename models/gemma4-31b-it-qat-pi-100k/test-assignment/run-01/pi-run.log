            border: 1px solid rgba(0,0,0,.12);
        }

        .disc-item {
            position: relative;
            padding: 18px 48px 18px 18px;
            font-size: 18px;
            color: #2C2C2C;
            border-top: 1px solid rgba(0,0,0,.12);
            // Use cursor: grab for desktop
            cursor: grab;
            background: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .disc-item:first-child { border-top: 0; }

        .disc-handle {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
